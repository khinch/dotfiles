/**
 * ROFI Color theme
 */

* {
    foreground:       #b9c9d5;
    background-color: transparent;
    dark:             #1c1c1c;
    black:            #2f3c45;
    lightblack:       #596d7c;
    tblack:           #2f3c45cc;
    blue:             #5a9bec;
    lightblue:        #87ceeb;
    highlight:        underline bold;
    transparent: rgba(0,0,0,0);
    font: "Inter Nerd Font 12";
}

window {
    location: center;
    anchor:   center;
    transparency: "real";
    padding: 10px;
    border:  0px;
    border-radius: 10px;
    background-color: @transparent;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
}

inputbar {
    color: @blue;
    padding: 11px;
    background-color: @black;
    transparency: "real";
    border: 2px 2px 2px 2px;
    border-radius:  8px 8px 0px 0px;
    border-color: @foreground;
    font: "Inter Nerd Font 12";
}

entry {
    text-font: inherit;
    text-color:inherit;
    border: 0px 0px 0px 10px;
}

prompt {
    text-font: inherit;
    text-color: inherit;
}

listview {
    padding: 8px;
    border-radius: 0px 0px 8px 8px;
    border-color: @foreground;
    border: 0px 2px 2px 2px;
    background-color: @tblack;
    dynamic: false;
    lines: 10;
}

element {
    padding: 3px;
    vertical-align: 0.5;
    border-radius: 4px;
    background-color: transparent;
    color: @foreground;
    font:inherit;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}

element selected.normal {
    background-color: @blue;
    text-color: @black;
}

element normal active {
    foreground: @lightblue;
}

element alternate active {
    foreground: @lightblue;
}

element selected active {
    background-color: @lightblue;
    foreground: @dark;
}

error-message {
    expand: true;
    background-color: red;
    border-color: darkred;
    border: 2px;
    padding: 1em;
}
